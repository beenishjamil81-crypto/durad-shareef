rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() &&
             ('email' in request.auth.token) &&
             request.auth.token.email == 'beenishjamil81@gmail.com' &&
             ('email_verified' in request.auth.token) &&
             request.auth.token.email_verified == true;
    }

    function isValidRecitation(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100 &&
             data.count is int && data.count >= 1 && data.count <= 10000000 &&
             data.duroodType is string && data.duroodType.size() >= 1 && data.duroodType.size() <= 100 &&
             (!('note' in data) || (data.note is string && data.note.size() <= 300)) &&
             data.isPublic is bool && data.isPublic == true &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidSummary(data) {
      return data.totalCount is int && data.totalCount >= 0 &&
             data.totalSubmissions is int && data.totalSubmissions >= 0 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /recitations/{recitationId} {
      allow get, list: if isSignedIn() && (resource.data.isPublic == true || resource.data.userId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(recitationId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'userName', 'count', 'duroodType', 'isPublic', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'userName', 'count', 'duroodType', 'note', 'isPublic', 'createdAt', 'updatedAt']) &&
                       isValidRecitation(incoming());

      allow update: if isSignedIn() &&
                       isValidId(recitationId) &&
                       (
                         isAdmin() ||
                         (
                           resource.data.userId == request.auth.uid &&
                           incoming().userId == existing().userId &&
                           incoming().createdAt == existing().createdAt &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['userName', 'count', 'duroodType', 'note', 'updatedAt'])
                         )
                       ) &&
                       isValidRecitation(incoming());

      allow delete: if isSignedIn() &&
                       isValidId(recitationId) &&
                       (isAdmin() || resource.data.userId == request.auth.uid);
    }

    match /summary/{summaryId} {
      allow get: if isSignedIn() && summaryId == 'global';
      allow list: if false;

      allow create: if isSignedIn() &&
                       summaryId == 'global' &&
                       incoming().keys().hasAll(['totalCount', 'totalSubmissions', 'updatedAt']) &&
                       incoming().keys().hasOnly(['totalCount', 'totalSubmissions', 'updatedAt']) &&
                       isValidSummary(incoming());

      allow update: if isSignedIn() &&
                       summaryId == 'global' &&
                       incoming().keys().hasOnly(['totalCount', 'totalSubmissions', 'updatedAt']) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['totalCount', 'totalSubmissions', 'updatedAt']) &&
                       isValidSummary(incoming());

      allow delete: if isAdmin() && summaryId == 'global';
    }
  }
}
